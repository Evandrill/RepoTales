# RepoTales — environment template
#
# Copy to `.env` (gitignored) and fill in real values:
#   cp .env.example .env
#
# Nothing here is required to boot: `docker compose up --build` works with the
# demo defaults, and mock sagas need neither GitHub nor the GPU.

# ── Ports ────────────────────────────────────────────────────────────────────
PORT=8080

# ── AMD GPU endpoints ────────────────────────────────────────────────────────
# vLLM (Qwen narrative model) — full OpenAI-compatible base URL.
VLLM_BASE_URL=http://129.212.191.240:8000/v1
# FLUX.1-schnell image server — base URL OR the full /generate-image path.
FLUX_BASE_URL=http://129.212.191.240:8001

# ── Evolus (optional integration) ────────────────────────────────────────────
EVOLUS_WORKSPACE_ID=your_evolus_workspace_id
EVOLUS_API_KEY=your_evolus_api_key

# ── Image generation tuning ──────────────────────────────────────────────────
AMD_IMAGE_TIMEOUT=120
# Fail fast when the FLUX host is down instead of queueing 120 s per panel.
AMD_IMAGE_CONNECT_TIMEOUT=4
AMD_IMAGE_QUEUE_TIMEOUT=30
# Threshold applies to transient failures (timeouts / 5xx). A connection
# failure (host down) opens the circuit immediately and skips the retries.
AMD_IMAGE_CIRCUIT_THRESHOLD=2
AMD_IMAGE_CIRCUIT_COOLDOWN=30

# ── GitHub ingestion ─────────────────────────────────────────────────────────
# Unauthenticated GitHub allows 60 req/h; one saga costs ~1 + N requests.
# Create a token at https://github.com/settings/tokens (public-repo read is
# enough; no scopes required for classic tokens) and paste it here.
GITHUB_TOKEN=
# Reuse the commit payload for repeated generations of the same repo (seconds).
GITHUB_CACHE_TTL=300
# Give up on per-commit diff stats after this many seconds.
GITHUB_STATS_TIMEOUT=12
GITHUB_MAX_CONCURRENCY=8

# ── Optional ─────────────────────────────────────────────────────────────────
# AMD_MODEL_NAME=Qwen/Qwen2.5-14B-Instruct
# VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct   # public alias for AMD_MODEL_NAME
# AMD_IMAGE_STEPS=2
# AMD_IMAGE_PREGENERATE=true
# CORS_ORIGINS=*
