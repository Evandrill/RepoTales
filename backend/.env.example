# Copier vers .env et remplir. .env est gitignore.
AMD_LLM_BASE_URL="http://localhost:8000/v1"
AMD_LLM_API_KEY="EMPTY"
AMD_MODEL_NAME="meta-llama/Meta-Llama-3.1-8B-Instruct"

# Optionnel — sans token, GitHub limite a 60 req/h (une saga = ~1 + N requetes).
GITHUB_TOKEN=""

# FLUX.1-schnell (serveur d'images) — relaye par GET /api/image-proxy.
AMD_IMAGE_SERVER_URL="http://129.212.191.240:8001/generate-image"
# AMD_IMAGE_ENABLED="true"          # false = aucune URL d'image dans la saga
# AMD_IMAGE_STEPS="2"               # FLUX.1-schnell : 2 suffit a 384px (max 3)
# AMD_IMAGE_STEPS_PARAM="steps"     # ou "num_inference_steps" selon le wrapper
# AMD_IMAGE_CONCURRENCY="1"         # 1 = strictement serialise (une seule instance CUDA)
# AMD_IMAGE_TIMEOUT="120"           # secondes (FLUX sur MI300X)
# AMD_IMAGE_PREGENERATE="true"      # pre-chauffe le cache apres /saga/generate
# AMD_IMAGE_CACHE_DIR="backend/.cache/images"

# Optionnel
# AMD_LLM_MAX_TOKENS="4096"
# AMD_LLM_CONTEXT_WINDOW="8192"   # = --max-model-len du serveur vLLM
# AMD_LLM_ALLOW_FALLBACK="true"
# AMD_LLM_JSON_MODE="true"
